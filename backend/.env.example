# Copia questo file in ".env" (stessa cartella) e imposta i tuoi valori.
# Il file ".env" non va condiviso né caricato su git: contiene la password.

# Password per accedere a /admin.html e alle API di scrittura.
# Senza questa variabile, il server usa una password di default INSICURA
# e lo segnala in console.
ADMIN_PASSWORD=cambia-questa-password

# Porta su cui gira il backend (facoltativa, default 3000)
# PORT=3000
